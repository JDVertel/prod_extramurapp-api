# Plantilla LOCAL — copiar a .env en tu PC:
#   cp .env.example .env
#
# Este archivo NO se sube a git. Cada entorno tiene su propio .env.

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# MySQL local
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=CAMBIAR_PASSWORD
MYSQL_DATABASE=extramurapp

JWT_SECRET=extramurapp-dev-secret-cambiar-en-servidor
JWT_EXPIRES_IN=12h
SHOW_RESET_TOKEN_IN_RESPONSE=true
