# Plantilla PRODUCCIÓN — copiar en el servidor como .env:
#   cp .env.production.example .env
#
# Edita los valores con la BD y credenciales del VPS.
# Este archivo NO se sube a git.

NODE_ENV=production
PORT=3000
# Orígenes separados por coma (frontend público + localhost si aplica)
CORS_ORIGIN=https://tudominio.com,https://www.tudominio.com

# MySQL del servidor (producción)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=extramurapp
MYSQL_PASSWORD=CAMBIAR_PASSWORD_PRODUCCION
MYSQL_DATABASE=extramurapp

JWT_SECRET=CAMBIAR_ESTE_SECRETO_EN_PRODUCCION
JWT_EXPIRES_IN=12h
SHOW_RESET_TOKEN_IN_RESPONSE=false
